# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection - use DB_* for local dev against a local Postgres.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SkillPathDB

# For deployment (e.g. Neon): set DATABASE_URL instead and leave DB_* unset -
# it takes priority when present and enables ssl, which hosted Postgres
# requires. Looks like: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Express server port (optional, defaults to 5000)
PORT=5000

# Comma-separated allowed origin(s) for CORS, e.g. your deployed frontend
# URL. Leave unset for local dev - cors() stays wide open, same as before.
CORS_ORIGIN=

# OpenAI - powers the quiz's course recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
