# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SkillPathDB

# Express server port (optional, defaults to 5000)
PORT=5000

# OpenAI - powers the quiz's course recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
